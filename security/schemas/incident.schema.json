{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/karun99/arthai/security/schemas/incident.schema.json",
  "title": "ArthAI Security Incident Record",
  "description": "Schema for a sanitized incident record (INC-*) in security/incidents/. Must never contain secrets or PII.",
  "type": "object",
  "required": [
    "incident_id",
    "threat_id",
    "date_detected",
    "status",
    "affected_component",
    "detection_method",
    "action",
    "validation",
    "resolution_date"
  ],
  "properties": {
    "incident_id": { "type": "string", "pattern": "^INC-[0-9]{4}-[0-9]{3}$" },
    "threat_id": { "type": "string", "pattern": "^ASDR-[0-9]{3}$" },
    "related_definition": { "type": "string", "pattern": "^ASDR-[0-9]{3}$" },
    "date_detected": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["open", "resolved", "monitoring"] },
    "description": { "type": "string" },
    "affected_component": { "type": "string" },
    "detection_method": { "type": "string" },
    "observed_behaviour": { "type": "string" },
    "severity": { "type": "string", "enum": ["Critical", "High", "Medium", "Low", "Informational"] },
    "action": { "type": "string" },
    "patch_remediation": { "type": "string" },
    "validation": { "type": "string", "enum": ["passed", "pending", "failed"] },
    "resolution_date": { "type": "string", "format": "date" },
    "lessons_learned": { "type": "string" }
  },
  "additionalProperties": false
}