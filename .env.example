# ──────────────────────────────────────────────────────────────────
# ArthAI environment variable template.
# Copy to `.env.local` / orchestrator secrets and FILL IN REAL VALUES
# there. NEVER commit real values. Placeholders below are inert and
# deliberately not secret-shaped.
# See SECURITY_POLICY.md Sections 5, 8.4 and RULE-SEC-001/002/005.
# ──────────────────────────────────────────────────────────────────

# ── Demo mode ────────────────────────────────────────────────────
NEXT_PUBLIC_DEMO_MODE=true

# ── Razorpay (fiat rail) ─────────────────────────────────────────
# Real keys are rzp_test_/rzp_live_ shaped — set in deployment env only.
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── S-AI / LLM providers ─────────────────────────────────────────
SAI_API_KEY=your_sai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Databases ────────────────────────────────────────────────────
DATABASE_URL=your_postgresql_url_here
REDIS_URL=your_redis_url_here

# ── Neo4j (knowledge graph) ──────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ── ChromaDB (vector memory) ─────────────────────────────────────
CHROMA_DB_HOST=localhost
CHROMA_DB_PORT=8000

# ── x402 / Circle (crypto rail) ──────────────────────────────────
# WALLET SECRETS MUST BE SET ONLY IN THE OWS MCP PROCESS ENVIRONMENT.
# NEVER in this file, NEVER in frontend (NEXT_PUBLIC_) scope.
# Referenced here as comments to document the requirement:
#   OWS_PRIVATE_KEY / OWS_SEED / CIRCLE_API_KEY  → ows-mcp env only.
X402_GATEWAY_URL=your_x402_gateway_url_here

# ── Metrics / observability ──────────────────────────────────────
# OTLP_ENDPOINT=your_otel_endpoint_here